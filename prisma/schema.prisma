generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String   @id @default(cuid())
  phone          String   @unique
  firstName      String?
  lastName       String?
  status         String   @default("חדש")
  subStatus      String?
  duplicateOf    String?
  source         String?
  origin         String   @default("leadmanager")
  intakeAt       DateTime @default(now())
  doNotContact   Boolean  @default(false)
  needsMapping   Boolean  @default(false)
  lastInboundAt  DateTime?
  chatId         String?
  botPausedUntil DateTime?
  callbackQueuedAt DateTime?
  callbackSentAt   DateTime?
  botMuted       Boolean  @default(false)
  notes          String?
  extra          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events         LeadEvent[]
  messages       Message[]
  jobs           ScheduledJob[]
  alerts         Alert[]
  tasks          Task[]
  entries        LeadEntry[]
  deliveries     LeadDelivery[]

  @@index([status])
  @@index([origin, intakeAt])
  @@index([subStatus])
  @@index([intakeAt])
}

model LeadEvent {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       String
  fromStatus String?
  toStatus   String?
  actor      String   @default("system")
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

model WebhookLog {
  id         String   @id @default(cuid())
  source     String
  rawPayload Json
  processed  Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([source, createdAt])
}

model Template {
  name        String   @id
  displayName String?
  bodyText    String?
  variables   Int      @default(0)
  approved    Boolean  @default(true)
  autoReply   Boolean  @default(false)
  raw         Json?
  syncedAt    DateTime @default(now())
}

model Message {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction       String   @default("out")
  templateName    String?
  bodyText        String?
  texterMessageId String?
  status          String   @default("sent")
  error           String?
  createdAt       DateTime @default(now())

  @@index([leadId, createdAt])
}

model Rule {
  id            String   @id @default(cuid())
  triggerStatus String
  stepIndex     Int
  delayMinutes  Int
  action        String   // send_template | notify | set_status
  templateName  String?
  targetStatus  String?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([triggerStatus, stepIndex])
  @@index([triggerStatus])
}

model ScheduledJob {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ruleId       String?
  stepIndex    Int      @default(0)
  action       String
  templateName String?
  targetStatus String?
  runAt        DateTime
  state        String   @default("pending") // pending | done | cancelled | failed
  attempts     Int      @default(0)
  lastError    String?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([leadId, ruleId, stepIndex])
  @@index([state, runAt])
}

model Alert {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  dueAt       DateTime?
  needsReview Boolean   @default(false)
  sourceQuestion String?
  urgent      Boolean   @default(false)
  done        Boolean   @default(false)
  doneAt      DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([done, dueAt])
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  topic     String
  answer    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Settings {
  id                   String   @id @default("main")
  botEnabled           Boolean  @default(true)
  botOnlyOutsideHours  Boolean  @default(false)
  botPauseHours        Int      @default(12)
  replyCooldownMinutes Int      @default(10)
  liveChatMinutes      Int      @default(30)
  onlyAfterTemplate    Boolean  @default(false)

  // הבוט נכנס לפעולה רק כשאתה לא בעבודה
  offDutyUntil          DateTime?
  afterHoursGrace       Int      @default(60)
  requireTemplateFirst  Boolean  @default(true)

  // הטקסטים שהעוזר שולח - ניתנים לעריכה מהמסך
  replyInterested      String   @default("היי, אסיים שיחה כמה דק ואתקשר :)")
  replyAfterHours      String   @default("היי, אני כבר סיימתי לעבוד. {מתי} מתאים לך?\nואם כן באיזה שעה :)")
  lastRunAt            DateTime?
  revenueTarget        Float     @default(0)

  // רשימת חזרה: אילו סטטוסים נכנסים אליה ומתי היא נשלחת
  callbackStatuses     Json?
  callbackMorningHour  Int       @default(10)
  callbackAfternoonHour Int      @default(13)
  callbackCutoffHour   Int       @default(18)
  callbackEnabled      Boolean   @default(false)

  // לאן מגיעות התראות: מייל, נייד, באנר במערכת
  // חייגן: לאיזו אפליקציה כפתור החיוג פונה.
  // {phone} מוחלף במספר. ברירת המחדל היא חייגן המכשיר.
  dialerMobile         String    @default("tel:{phone}")
  dialerDesktop        String    @default("tel:{phone}")

  notifyEmail          Boolean   @default(true)
  notifyPush           Boolean   @default(true)
  notifyBanner         Boolean   @default(true)

  // הבוט: מתי הוא פעיל ועל אילו סטטוסים הוא עונה
  botFromHour          Int       @default(8)
  botToHour            Int       @default(21)
  botStatuses          Json?

  // אילו סטטוסים נחשבים סגירה לצורך אחוז המכירה
  closeStatuses        Json?

  // אילו סטטוסים אומרים "הלקוח התחבר, אבל לא דרכי".
  // זה מה שמסך התחרות מודד.
  lostStatuses         Json?
  leadRowFields        Json?
  replyCallback        String   @default("מעולה, רשמתי. אחזור אליך בזמן שביקשת :)")

  updatedAt            DateTime @updatedAt
}

model Status {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  position  Int      @default(100)
  terminal  Boolean  @default(false)
  won       Boolean  @default(false)
  builtin   Boolean  @default(false)
  commission Float   @default(0)
  createdAt DateTime @default(now())

  @@index([position])
}

model SubStatus {
  id         String   @id @default(cuid())
  statusName String
  name       String
  position   Int      @default(0)
  commission Float    @default(0)
  createdAt  DateTime @default(now())

  @@unique([statusName, name])
  @@index([statusName, position])
}

model Offer {
  id        String   @id @default(cuid())
  title     String
  price     String?
  decoders  String?
  streaming String?
  sports    String?
  freeText  String?
  targets   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sends     OfferSend[]

  @@index([active, createdAt])
}

model OfferSend {
  id           String   @id @default(cuid())
  offerId      String
  offer        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  templateName String
  total        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([offerId])
}

model ImportRun {
  id        String   @id @default(cuid())
  fileName  String?
  rows      Int      @default(0)
  matched   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  report    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// קמפיין שבו הלידים נמכרים ולא נעבדים
model SalesCampaign {
  id           String   @id @default(cuid())
  name         String   @unique

  /// מזהים נוספים שמסמנים ליד כשייך לקמפיין הזה:
  /// מזהה טופס, קמפיין, מודעה או קבוצת מודעות בפייסבוק,
  /// או שם חלופי של הקמפיין.
  ///
  /// למה: שם קמפיין הוא טקסט חופשי. הוא יכול להשתנות,
  /// ולא תמיד מגיע בכלל - ואז הליד נחשב בטעות שלך ונכנס
  /// לרשימה שלך. מזהה לא משתנה ותמיד מגיע.
  matchKeys    String[] @default([])

  pricePerLead Float    @default(0)
  buyer        String?
  buyerId      String?
  buyerRef     LeadBuyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

/// מי שקונה ממך לידים
model LeadBuyer {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  createdAt DateTime @default(now())

  /// לאן לשלוח כל ליד שנמכר לו. ריק = לא נשלח כלום
  webhookUrl    String?
  /// נוסף לבקשה כ-token, אם הקונה דורש אימות
  webhookSecret String?
  /// json (ברירת מחדל) או form, לפי מה שהצד השני מצפה לו
  webhookFormat String  @default("json")
  /// שינוי שמות שדות: { "phone": "telephone" } - לכל קונה המבנה שלו
  fieldMap      Json?
  /// כיבוי זמני בלי למחוק את ההגדרות
  sendEnabled   Boolean @default(true)

  campaigns  SalesCampaign[]
  deliveries LeadDelivery[]
  forms      LeadForm[]
}

/// ============================================================
///  יומן השליחות לקונים
/// ============================================================
///
///  שורה לכל ניסיון שליחה. בלי זה אי אפשר לענות על השאלה
///  הכי חשובה בעסק הזה: "הליד הגיע אליו או לא?"
///
///  כישלון לא נמחק - הוא נשאר עם הסיבה, ואפשר לשלוח שוב.
model LeadDelivery {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     LeadBuyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// הכניסה שבגללה נשלח, כדי שלא נשלח פעמיים על אותה הגעה
  entryId   String?

  state      String   @default("pending") // pending | sent | failed
  attempts   Int      @default(0)
  httpStatus Int?
  error      String?
  payload    Json?
  response   String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  nextTryAt DateTime?

  @@unique([buyerId, entryId])
  @@index([state, nextTryAt])
  @@index([leadId])
}

/// כל כניסה של ליד, בנפרד.
/// אותו אדם יכול להיכנס מכמה קמפיינים - וכל כניסה נספרת.
model LeadEntry {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// מאיזו דלת הליד נכנס: leadmanager או facebook.
  /// זה מה שמאפשר לדעת אם החיבור הישיר באמת מביא לידים.
  via       String?
  campaign  String?
  source    String?
  isSale    Boolean  @default(false)
  billable  Boolean  @default(true)
  price     Float    @default(0)
  at        DateTime @default(now())

  @@index([isSale, at])
  @@index([leadId])
  @@index([campaign])
}

/// רשימת דיוור - אנשי קשר שאינם לידים
model BroadcastList {
  id        String   @id @default(cuid())
  name      String
  note      String?
  createdAt DateTime @default(now())

  contacts  BroadcastContact[]
  sends     BroadcastSend[]

  @@index([createdAt])
}

model BroadcastContact {
  id        String   @id @default(cuid())
  listId    String
  list      BroadcastList @relation(fields: [listId], references: [id], onDelete: Cascade)
  phone     String
  firstName String?
  createdAt DateTime @default(now())

  @@unique([listId, phone])
  @@index([listId])
}

model BroadcastSend {
  id           String   @id @default(cuid())
  listId       String
  list         BroadcastList @relation(fields: [listId], references: [id], onDelete: Cascade)
  templateName String
  total        Int      @default(0)
  sent         Int      @default(0)
  failed       Int      @default(0)
  state        String   @default("running")
  createdAt    DateTime @default(now())
  finishedAt   DateTime?

  @@index([listId])
}

/// קטגוריית הוצאה - פרסום, מרכזייה, תפעול וכו'
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  expenses  Expense[]

  @@index([position])
}

model Expense {
  id         String   @id @default(cuid())
  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title      String
  amount     Float    @default(0)
  at         DateTime @default(now())
  recurring  Boolean  @default(false)
  note       String?
  createdAt  DateTime @default(now())

  @@index([at])
  @@index([categoryId])
}

/// יעד ביצועים לקמפיין. שורה בלי שם קמפיין = ברירת מחדל לכולם
model CampaignRule {
  id            String   @id @default(cuid())
  campaignName  String?  @unique
  targetPercent Float    @default(15)
  graceDays     Int      @default(7)
  recheckDays   Int      @default(7)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// תיעוד בדיקה, כדי לדעת מתי לבדוק שוב ולא להתריע פעמיים
model CampaignCheck {
  id           String   @id @default(cuid())
  campaignName String
  leads        Int      @default(0)
  closes       Int      @default(0)
  percent      Float    @default(0)
  target       Float    @default(0)
  passed       Boolean  @default(false)
  checkedAt    DateTime @default(now())

  @@index([campaignName, checkedAt])
}

/// באנר שמופיע בראש המסך עד שמסירים אותו
model Notice {
  id           String    @id @default(cuid())
  kind         String    @default("campaign")
  leadId       String?
  level        String    @default("bad")
  title        String
  body         String?
  campaignName String?
  createdAt    DateTime  @default(now())
  dismissedAt  DateTime?

  @@index([dismissedAt, createdAt])
}

/// מכשיר שרשום לקבל התראות דחיפה
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now())
}

/**
 * ============================================================
 *  טופס לידים של פייסבוק, ולמי הוא שייך
 * ============================================================
 *
 *  הטופס הוא היחידה הנכונה לשיוך, ולא שם הקמפיין: טופס
 *  מחובר לקונה אחד, ושמו לא משתנה כשמשנים שם מודעה.
 *
 *  הרשומות נוצרות מתוך רשימת הטפסים שנשלפת מפייסבוק, כדי
 *  שלא תידרש הקלדה של מזהים.
 */
model LeadForm {
  id       String @id @default(cuid())

  /// מזהה הטופס בפייסבוק
  formId   String @unique
  formName String
  pageId   String
  pageName String

  /// mine = הלידים שלך · sale = נמכרים לקונה
  channel  String @default("mine")

  buyerId  String?
  buyer    LeadBuyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  /// מחיר לליד, כשהטופס שייך לקונה
  pricePerLead Float @default(0)

  /// איזו שאלה בטופס היא שאלת הספק. ריק = זיהוי אוטומטי.
  supplierKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channel])
}
