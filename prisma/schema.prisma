generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String   @id @default(cuid())
  phone          String   @unique
  firstName      String?
  lastName       String?
  status         String   @default("חדש")
  subStatus      String?
  duplicateOf    String?
  source         String?
  origin         String   @default("leadmanager")
  intakeAt       DateTime @default(now())
  doNotContact   Boolean  @default(false)
  /// מתי נכנס לרשימה השחורה, למה, ומה בדיוק כתב.
  /// בלי זה אי אפשר לדעת למה מישהו ברשימה, ואי אפשר
  /// להגן על ההחלטה אם הוא יטען שלא ביקש.
  doNotContactAt     DateTime?
  doNotContactReason String?
  doNotContactText   String?
  needsMapping   Boolean  @default(false)
  lastInboundAt  DateTime?
  chatId         String?
  botPausedUntil DateTime?
  callbackQueuedAt DateTime?
  callbackSentAt   DateTime?
  botMuted       Boolean  @default(false)
  notes          String?
  extra          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events         LeadEvent[]
  messages       Message[]
  jobs           ScheduledJob[]
  alerts         Alert[]
  tasks          Task[]
  entries        LeadEntry[]
  deliveries     LeadDelivery[]

  @@index([status])
  @@index([doNotContact])
  @@index([origin, intakeAt])
  @@index([subStatus])
  @@index([intakeAt])
}

model LeadEvent {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       String
  fromStatus String?
  toStatus   String?
  actor      String   @default("system")
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

model WebhookLog {
  id         String   @id @default(cuid())
  source     String
  rawPayload Json
  processed  Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([source, createdAt])
}

model Template {
  name        String   @id
  displayName String?
  bodyText    String?
  variables   Int      @default(0)
  approved    Boolean  @default(true)
  autoReply   Boolean  @default(false)
  raw         Json?
  syncedAt    DateTime @default(now())
}

model Message {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction       String   @default("out")
  /// נשלחה כדיוור - רשימה שטענת, מבצע, או דיוור מרשימת
  /// הלידים. סימון מפורש ולא ניחוש מתוך הטקסט: קודם ההיכר
  /// היה "האם הטקסט מתחיל ב'דיוור:'", ולכן כל דיוור שיצא
  /// כתבנית רגילה לא נספר כדיוור בכלל.
  broadcast       Boolean  @default(false)
  templateName    String?
  bodyText        String?
  texterMessageId String?
  status          String   @default("sent")
  error           String?
  createdAt       DateTime @default(now())

  @@index([leadId, createdAt])
}

model Rule {
  id            String   @id @default(cuid())
  triggerStatus String
  stepIndex     Int
  delayMinutes  Int
  action        String   // send_template | notify | set_status
  templateName  String?
  targetStatus  String?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([triggerStatus, stepIndex])
  @@index([triggerStatus])
}

model ScheduledJob {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ruleId       String?
  stepIndex    Int      @default(0)
  action       String
  templateName String?
  targetStatus String?
  runAt        DateTime
  state        String   @default("pending") // pending | done | cancelled | failed
  attempts     Int      @default(0)
  lastError    String?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([leadId, ruleId, stepIndex])
  @@index([state, runAt])
}

model Alert {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  dueAt       DateTime?
  needsReview Boolean   @default(false)
  sourceQuestion String?
  urgent      Boolean   @default(false)
  done        Boolean   @default(false)
  doneAt      DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([done, dueAt])
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  topic     String
  answer    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Settings {
  id                   String   @id @default("main")
  botEnabled           Boolean  @default(true)
  /// "all" - הבוט מטפל בכל הודעה נכנסת, כמו עד היום.
  /// "broadcast" - הבוט מטפל **רק** בתגובות לדיוור: שואל
  /// את שאלת הסינון, קורא את התשובה, ומפסיק שם. כל הודעה
  /// אחרת נשארת לך בלי שהוא נוגע בה.
  botMode              String   @default("all")
  botOnlyOutsideHours  Boolean  @default(false)
  botPauseHours        Int      @default(12)
  replyCooldownMinutes Int      @default(10)
  liveChatMinutes      Int      @default(30)
  onlyAfterTemplate    Boolean  @default(false)

  // הבוט נכנס לפעולה רק כשאתה לא בעבודה
  offDutyUntil          DateTime?
  afterHoursGrace       Int      @default(60)
  requireTemplateFirst  Boolean  @default(true)

  // הטקסטים שהעוזר שולח - ניתנים לעריכה מהמסך
  replyInterested      String   @default("היי, אסיים שיחה כמה דק ואתקשר :)")
  replyAfterHours      String   @default("היי, אני כבר סיימתי לעבוד. {מתי} מתאים לך?\nואם כן באיזה שעה :)")
  lastRunAt            DateTime?
  revenueTarget        Float     @default(0)

  // רשימת חזרה: אילו סטטוסים נכנסים אליה ומתי היא נשלחת
  callbackStatuses     Json?
  callbackMorningHour  Int       @default(10)
  callbackAfternoonHour Int      @default(13)
  callbackCutoffHour   Int       @default(18)
  callbackEnabled      Boolean   @default(false)

  // לאן מגיעות התראות: מייל, נייד, באנר במערכת
  // חייגן: לאיזו אפליקציה כפתור החיוג פונה.
  // {phone} מוחלף במספר. ברירת המחדל היא חייגן המכשיר.
  dialerMobile         String    @default("tel:{phone}")
  dialerDesktop        String    @default("tel:{phone}")

  notifyEmail          Boolean   @default(true)
  notifyPush           Boolean   @default(true)
  notifyBanner         Boolean   @default(true)

  // הבוט: מתי הוא פעיל ועל אילו סטטוסים הוא עונה
  botFromHour          Int       @default(8)
  botToHour            Int       @default(21)
  botStatuses          Json?

  // אילו סטטוסים נחשבים סגירה לצורך אחוז המכירה
  closeStatuses        Json?

  // אילו סטטוסים אומרים "הלקוח התחבר, אבל לא דרכי".
  // זה מה שמסך התחרות מודד.
  lostStatuses         Json?
  leadRowFields        Json?
  /// אילו שדות מוצגים בשורת ליד ברשימת המכירה.
  /// ריק = ברירת המחדל. עמודה חדשה ובטוחה.
  saleRowFields        Json?
  /// אילו סטטוסים לא נכנסים למסך הדאטה.
  /// ריק = ברירת המחדל (נסגר, לקוח קיים).
  dataExcludeStatuses  Json?
  /// על אילו לידים נשלח מייל: all | mine | sale | off
  leadEmailMode        String?
  replyCallback        String   @default("מעולה, רשמתי. אחזור אליך בזמן שביקשת :)")

  updatedAt            DateTime @updatedAt
}

model Status {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  position  Int      @default(100)
  terminal  Boolean  @default(false)
  won       Boolean  @default(false)
  builtin   Boolean  @default(false)
  commission Float   @default(0)

  /// סטטוס שמעביר את הליד לקונה.
  /// ברגע שליד מקבל את הסטטוס הזה הוא נמכר: עובר לערוץ
  /// המכירה, יוצא מהרשימה האישית, ונשלח לקונה.
  /// ריק = הסטטוס לא מעביר כלום.
  transferBuyerId String?
  transferBuyer   LeadBuyer? @relation(fields: [transferBuyerId], references: [id], onDelete: SetNull)

  /// המחיר שהקונה משלם על ליד שהועבר ככה
  transferPrice   Float    @default(0)

  /// סטטוס שמעביר את הליד לערוץ.
  /// זו הדרך המועדפת: הערוץ מחזיק את הוובוק, המחיר וההגדרות,
  /// ולכן אין מה להגדיר פעמיים.
  transferChannelId String?
  transferChannel   Channel? @relation(fields: [transferChannelId], references: [id], onDelete: SetNull)

  /// ---------- וובוק יוצא ----------
  /// כתובת שאליה נשלחת הודעה כשליד מקבל את הסטטוס הזה.
  /// שולח בלבד - לא מוכר את הליד ולא מזיז אותו מהרשימה שלך.
  /// ריק = לא נשלח כלום.
  hookUrl      String?
  /// גוף הבקשה כתבנית עם אסימונים. ריק = נשלח המטען הרגיל.
  hookTemplate String?
  /// כותרות מותאמות: { "X-API-Key": "..." }
  hookHeaders  Json?
  /// נוסף כ-Bearer, אם הצד השני דורש אימות
  hookSecret   String?
  /// כיבוי זמני בלי למחוק את ההגדרות
  hookActive   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([position])
}

model SubStatus {
  id         String   @id @default(cuid())
  statusName String
  name       String
  position   Int      @default(0)
  commission Float    @default(0)
  createdAt  DateTime @default(now())

  @@unique([statusName, name])
  @@index([statusName, position])
}

model Offer {
  id        String   @id @default(cuid())
  title     String
  price     String?
  decoders  String?
  streaming String?
  sports    String?
  freeText  String?
  targets   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sends     OfferSend[]

  @@index([active, createdAt])
}

model OfferSend {
  id           String   @id @default(cuid())
  offerId      String
  offer        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  templateName String
  total        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([offerId])
}

model ImportRun {
  id        String   @id @default(cuid())
  fileName  String?
  rows      Int      @default(0)
  matched   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  report    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// קמפיין שבו הלידים נמכרים ולא נעבדים
model SalesCampaign {
  id           String   @id @default(cuid())
  name         String   @unique

  /// מזהים נוספים שמסמנים ליד כשייך לקמפיין הזה:
  /// מזהה טופס, קמפיין, מודעה או קבוצת מודעות בפייסבוק,
  /// או שם חלופי של הקמפיין.
  ///
  /// למה: שם קמפיין הוא טקסט חופשי. הוא יכול להשתנות,
  /// ולא תמיד מגיע בכלל - ואז הליד נחשב בטעות שלך ונכנס
  /// לרשימה שלך. מזהה לא משתנה ותמיד מגיע.
  matchKeys    String[] @default([])

  pricePerLead Float    @default(0)
  buyer        String?
  buyerId      String?
  buyerRef     LeadBuyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

/// מי שקונה ממך לידים
model LeadBuyer {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  createdAt DateTime @default(now())

  /// לאן לשלוח כל ליד שנמכר לו. ריק = לא נשלח כלום
  webhookUrl    String?
  /// נוסף לבקשה כ-token, אם הקונה דורש אימות
  webhookSecret String?
  /// json (ברירת מחדל) או form, לפי מה שהצד השני מצפה לו
  webhookFormat String  @default("json")
  /// שינוי שמות שדות: { "phone": "telephone" } - לכל קונה המבנה שלו
  fieldMap      Json?

  /// גוף השידור כתבנית, עם אסימונים: { "name": "{full_name}" }
  /// ריק = נשלח המטען הרגיל לפי מיפוי השמות
  bodyTemplate  String?

  /// כותרות מותאמות, שורה לכל אחת: X-API-Key=abc
  headers       Json?

  /// טקסט שחייב להופיע בתשובה כדי שהשליחה תיחשב הצליחה
  successContains String?

  /// טקסט שאם הופיע בתשובה - השליחה נחשבת שנכשלה, גם ב-200
  failureContains String?
  /// כיבוי זמני בלי למחוק את ההגדרות
  sendEnabled   Boolean @default(true)

  campaigns  SalesCampaign[]
  deliveries LeadDelivery[]
  forms      LeadForm[]
  statuses   Status[]
}

/// ============================================================
///  יומן השליחות לקונים
/// ============================================================
///
///  שורה לכל ניסיון שליחה. בלי זה אי אפשר לענות על השאלה
///  הכי חשובה בעסק הזה: "הליד הגיע אליו או לא?"
///
///  כישלון לא נמחק - הוא נשאר עם הסיבה, ואפשר לשלוח שוב.
model LeadDelivery {
  id        String   @id @default(cuid())

  /// הערוץ שבגללו נשלח - הדרך מעכשיו.
  channelId String?
  channelRef Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  /// הקונה, בשליחות ותיקות שנשלחו לפני שהיו ערוצים.
  /// נשאר אופציונלי כדי שההיסטוריה לא תאבד.
  buyerId   String?
  buyer     LeadBuyer? @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// הכניסה שבגללה נשלח, כדי שלא נשלח פעמיים על אותה הגעה
  entryId   String?

  state      String   @default("pending") // pending | sent | failed
  attempts   Int      @default(0)
  httpStatus Int?
  error      String?
  payload    Json?
  response   String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  nextTryAt DateTime?

  /// שתי הגנות נפרדות מפני שליחה כפולה על אותה הגעה:
  /// אחת לערוץ ואחת לקונה הוותיק.
  /// למה אינדקס רגיל ולא ייחודי:
  ///
  /// אינדקס ייחודי חדש גורם ל-prisma db push לעצור ולדרוש
  /// --accept-data-loss, והבנייה ברנדר נכשלת. ההגנה מפני
  /// שליחה כפולה לאותו ערוץ נאכפת ב-queueDelivery במקום.
  @@index([channelId, entryId])
  @@unique([buyerId, entryId])
  @@index([state, nextTryAt])
  @@index([leadId])
}

/// כל כניסה של ליד, בנפרד.
/// אותו אדם יכול להיכנס מכמה קמפיינים - וכל כניסה נספרת.
model LeadEntry {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// מאיזו דלת הליד נכנס: leadmanager או facebook.
  /// זה מה שמאפשר לדעת אם החיבור הישיר באמת מביא לידים.
  via       String?

  /// הערוץ שההגעה הזו שייכת אליו
  channelId String?
  channelRef Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  campaign  String?
  source    String?
  isSale    Boolean  @default(false)
  billable  Boolean  @default(true)
  price     Float    @default(0)
  at        DateTime @default(now())

  @@index([isSale, at])
  @@index([leadId])
  @@index([campaign])
}

/// רשימת דיוור - אנשי קשר שאינם לידים
model BroadcastList {
  id        String   @id @default(cuid())
  name      String
  note      String?
  createdAt DateTime @default(now())

  contacts  BroadcastContact[]
  sends     BroadcastSend[]

  @@index([createdAt])
}

model BroadcastContact {
  id        String   @id @default(cuid())
  listId    String
  list      BroadcastList @relation(fields: [listId], references: [id], onDelete: Cascade)
  phone     String
  firstName String?
  createdAt DateTime @default(now())

  @@unique([listId, phone])
  @@index([listId])
}

/// רישום לכל נמען בנפרד בדיוור.
///
/// בלי זה אי אפשר היה לדעת מי כבר קיבל: המערכת ספרה רק
/// "כמה נשלחו", והמשך דיוור היה מתחיל מההתחלה ושולח שוב
/// לאותם אנשים. הטבלה הזו היא גם יומן וגם ההגנה מכפילות.
model BroadcastDelivery {
  id        String   @id @default(cuid())
  sendId    String
  send      BroadcastSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  contactId String
  phone     String
  ok        Boolean  @default(false)
  /// נמען שדולג כי הוא ברשימה השחורה. נרשם ולא נעלם,
  /// כדי שתראה בדוח שהוא דולג ולא תחשוב שהוא קיבל.
  skipped   Boolean  @default(false)
  error     String?
  at        DateTime @default(now())

  /// שתי שליחות לאותו נמען באותו דיוור הן באג, לא תרחיש
  @@unique([sendId, contactId])
  @@index([sendId])
}

model BroadcastSend {
  id           String   @id @default(cuid())
  listId       String
  list         BroadcastList @relation(fields: [listId], references: [id], onDelete: Cascade)
  templateName String
  total        Int      @default(0)
  sent         Int      @default(0)
  failed       Int      @default(0)
  /// כמה דולגו כי הם ברשימה השחורה
  skipped      Int      @default(0)
  state        String   @default("running")
  createdAt    DateTime @default(now())
  finishedAt   DateTime?
  deliveries   BroadcastDelivery[]

  @@index([listId])
}

/// קטגוריית הוצאה - פרסום, מרכזייה, תפעול וכו'
model ExpenseCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  expenses  Expense[]

  @@index([position])
}

model Expense {
  id         String   @id @default(cuid())
  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title      String
  amount     Float    @default(0)
  at         DateTime @default(now())
  recurring  Boolean  @default(false)
  note       String?
  createdAt  DateTime @default(now())

  @@index([at])
  @@index([categoryId])
}

/// יעד ביצועים לקמפיין. שורה בלי שם קמפיין = ברירת מחדל לכולם
model CampaignRule {
  id            String   @id @default(cuid())
  campaignName  String?  @unique
  targetPercent Float    @default(15)
  graceDays     Int      @default(7)
  recheckDays   Int      @default(7)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// תיעוד בדיקה, כדי לדעת מתי לבדוק שוב ולא להתריע פעמיים
model CampaignCheck {
  id           String   @id @default(cuid())
  campaignName String
  leads        Int      @default(0)
  closes       Int      @default(0)
  percent      Float    @default(0)
  target       Float    @default(0)
  passed       Boolean  @default(false)
  checkedAt    DateTime @default(now())

  @@index([campaignName, checkedAt])
}

/// באנר שמופיע בראש המסך עד שמסירים אותו
model Notice {
  id           String    @id @default(cuid())
  kind         String    @default("campaign")
  leadId       String?
  level        String    @default("bad")
  title        String
  body         String?
  campaignName String?
  createdAt    DateTime  @default(now())
  dismissedAt  DateTime?

  @@index([dismissedAt, createdAt])
}

/// מכשיר שרשום לקבל התראות דחיפה
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  label     String?
  createdAt DateTime @default(now())
}

/// ============================================================
///  טופס לידים של פייסבוק, ולמי הוא שייך
/// ============================================================
///
///  הטופס הוא היחידה הנכונה לשיוך, ולא שם הקמפיין: טופס
///  מחובר לקונה אחד, ושמו לא משתנה כשמשנים שם מודעה.
///
///  הרשומות נוצרות מתוך רשימת הטפסים שנשלפת מפייסבוק, כדי
///  שלא תידרש הקלדה של מזהים.
model LeadForm {
  id       String @id @default(cuid())

  /// מזהה הטופס בפייסבוק
  formId   String @unique
  formName String
  pageId   String
  pageName String

  /// mine = הלידים שלך · sale = נמכרים לקונה
  /// נשאר לתאימות; הערוץ הוא מה שקובע מעכשיו
  channel  String @default("mine")

  /// הערוץ שהטופס הזה מזין. זה השיוך שנעשה מתוך הערוץ עצמו
  channelId String?
  channelRef Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  buyerId  String?
  buyer    LeadBuyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  /// מחיר לליד, כשהטופס שייך לקונה
  pricePerLead Float @default(0)

  /// איזו שאלה בטופס היא שאלת הספק. ריק = זיהוי אוטומטי.
  supplierKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channel])
}

/// ============================================================
///  הוצאת פרסום לפי קמפיין, מפייסבוק
/// ============================================================
///
///  שורה אחת לכל קמפיין לכל יום. זה מה שמאפשר לחשב עלות
///  לליד ועלות לסגירה - המספרים שלפיהם מחליטים מה להגדיל
///  ומה לסגור.
///
///  מכוון **לא** נכנס לתמונת הרווח של מסך ההוצאות: שם אתה
///  מזין הוצאות ידנית, וספירה כפולה של אותו כסף הייתה
///  מעוותת לך את הרווח בשקט.
model AdSpend {
  id          String   @id @default(cuid())

  /// היום שאליו ההוצאה שייכת, בשעון ישראל
  date        DateTime
  accountId   String
  accountName String?
  campaignId  String
  campaignName String
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  /// מספר הלידים שפייסבוק עצמה מדווחת, להשוואה מול מה שנקלט אצלך
  fbLeads     Int      @default(0)
  syncedAt    DateTime @default(now())

  @@unique([date, campaignId])
  @@index([date])
  @@index([campaignId])
}

/// ============================================================
///  קמפיינים וערוצים - שכבת הניתוב היחידה
/// ============================================================
///
///  קמפיין הוא קטגוריה: "מכירת לידים", "לידים רובי",
///  "איזי פיזי". בתוכו ערוצים.
///
///  ערוץ הוא היחידה שמחזיקה הכל במקום אחד: אילו טפסים
///  מפייסבוק מזינים אותו, לאן הלידים שלו נשלחים, האם הוא
///  ערוץ מכירה, מה המחיר, והאם השליחה אוטומטית.
///
///  למה זה מאוחד ככה: עד עכשיו הקונה, הקמפיין, הטופס
///  והשליחה היו ארבעה דברים נפרדים שהיה צריך לחבר ביניהם
///  בכל פעם - וכל חיבור שנשכח היה ליד שהלך לערוץ הלא נכון.
model Campaign {
  id       String  @id @default(cuid())
  name     String  @unique
  position Int     @default(100)
  active   Boolean @default(true)
  createdAt DateTime @default(now())

  channels Channel[]

  @@index([position])
}

model Channel {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String

  /// האם לידים בערוץ הזה יוצאים מהרשימה האישית שלך.
  /// ערוץ מכירה = כן. ערוץ שלך = לא.
  isSale       Boolean @default(false)
  pricePerLead Float   @default(0)

  /// ---------- לאן נשלח ----------
  webhookUrl      String?
  webhookSecret   String?
  webhookFormat   String  @default("json")
  /// גוף השידור כתבנית עם אסימונים
  bodyTemplate    String?
  headers         Json?
  successContains String?
  failureContains String?
  /// אילו שדות הצד השני מקבל, לפי סימון במסך.
  /// רשימה ריקה = שולח הכל, כדי שערוץ ותיק לא יפסיק
  /// לשלוח שדות רק מפני שלא נגעו בו.
  fields          String[] @default([])
  /// חריגי מחיר לפי מודעה: [{ match, price }].
  /// מאפשר שתי מודעות באותו קמפיין בתמחור שונה, בלי
  /// לפצל אותן לשני קמפיינים שיתחרו זה בזה.
  adPrices        Json?
  /// כיבוי זמני בלי למחוק הגדרות
  sendEnabled     Boolean @default(true)
  /// כל ליד שנכנס לערוץ נשלח אוטומטית
  autoSend        Boolean @default(true)

  position  Int      @default(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forms      LeadForm[]
  entries    LeadEntry[]
  deliveries LeadDelivery[]
  statuses   Status[]

  @@unique([campaignId, name])
  @@index([isSale])
}

/// ============================================================
///  תצוגות שמורות לרשימת הלידים
/// ============================================================
///
///  ברירת המחדל מציגה את הרשימה הרגילה. תצוגה שמורה מצמצמת
///  אותה לקמפיינים ולערוצים שבחרת, ונשמרת בשם - כדי שתוכל
///  לבחור אותה שוב בלי להגדיר מחדש.
///
///  התצוגה היא **הגדרה ולא צילום**: ליד שייכנס מחר לערוץ
///  שנמצא בתצוגה יופיע בה מעצמו.
model LeadView {
  id          String   @id @default(cuid())
  name        String   @unique

  /// קמפיינים שנבחרו - כל הערוצים שבהם נכללים
  campaignIds String[] @default([])
  /// ערוצים בודדים שנבחרו
  channelIds  String[] @default([])

  /// האם להציג גם לידים של ערוצי מכירה.
  /// ברירת המחדל לא, כדי לא לערב את הנתונים של הקונים
  /// ברשימה האישית בטעות.
  includeSale Boolean  @default(false)

  position  Int      @default(100)
  createdAt DateTime @default(now())

  @@index([position])
}
