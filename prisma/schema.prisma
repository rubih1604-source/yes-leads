generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String   @id @default(cuid())
  phone          String   @unique
  firstName      String?
  lastName       String?
  status         String   @default("חדש")
  source         String?
  intakeAt       DateTime @default(now())
  doNotContact   Boolean  @default(false)
  needsMapping   Boolean  @default(false)
  lastInboundAt  DateTime?
  chatId         String?
  botPausedUntil DateTime?
  botMuted       Boolean  @default(false)
  notes          String?
  extra          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events         LeadEvent[]
  messages       Message[]
  jobs           ScheduledJob[]
  alerts         Alert[]
  tasks          Task[]

  @@index([status])
  @@index([intakeAt])
}

model LeadEvent {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       String
  fromStatus String?
  toStatus   String?
  actor      String   @default("system")
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

model WebhookLog {
  id         String   @id @default(cuid())
  source     String
  rawPayload Json
  processed  Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([source, createdAt])
}

model Template {
  name        String   @id
  displayName String?
  bodyText    String?
  variables   Int      @default(0)
  approved    Boolean  @default(true)
  raw         Json?
  syncedAt    DateTime @default(now())
}

model Message {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction       String   @default("out")
  templateName    String?
  bodyText        String?
  texterMessageId String?
  status          String   @default("sent")
  error           String?
  createdAt       DateTime @default(now())

  @@index([leadId, createdAt])
}

model Rule {
  id            String   @id @default(cuid())
  triggerStatus String
  stepIndex     Int
  delayMinutes  Int
  action        String   // send_template | notify | set_status
  templateName  String?
  targetStatus  String?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([triggerStatus, stepIndex])
  @@index([triggerStatus])
}

model ScheduledJob {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ruleId       String
  stepIndex    Int
  action       String
  templateName String?
  targetStatus String?
  runAt        DateTime
  state        String   @default("pending") // pending | done | cancelled | failed
  attempts     Int      @default(0)
  lastError    String?
  createdAt    DateTime @default(now())

  @@unique([leadId, ruleId, stepIndex])
  @@index([state, runAt])
}

model Alert {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  dueAt       DateTime?
  needsReview Boolean   @default(false)
  sourceQuestion String?
  urgent      Boolean   @default(false)
  done        Boolean   @default(false)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([done, dueAt])
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  topic     String
  answer    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Settings {
  id                   String   @id @default("main")
  botEnabled           Boolean  @default(true)
  botOnlyOutsideHours  Boolean  @default(false)
  botPauseHours        Int      @default(12)
  replyCooldownMinutes Int      @default(10)

  // הטקסטים שהעוזר שולח - ניתנים לעריכה מהמסך
  replyInterested      String   @default("היי, אסיים שיחה כמה דק ואתקשר :)")
  replyAfterHours      String   @default("היי, אני כבר סיימתי לעבוד. {מתי} מתאים לך?\nואם כן באיזה שעה :)")
  replyCallback        String   @default("מעולה, רשמתי. אחזור אליך בזמן שביקשת :)")

  updatedAt            DateTime @updatedAt
}
