generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String   @id @default(cuid())
  phone          String   @unique
  firstName      String?
  lastName       String?
  status         String   @default("חדש")
  subStatus      String?
  duplicateOf    String?
  source         String?
  origin         String   @default("leadmanager")
  intakeAt       DateTime @default(now())
  doNotContact   Boolean  @default(false)
  needsMapping   Boolean  @default(false)
  lastInboundAt  DateTime?
  chatId         String?
  botPausedUntil DateTime?
  botMuted       Boolean  @default(false)
  notes          String?
  extra          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events         LeadEvent[]
  messages       Message[]
  jobs           ScheduledJob[]
  alerts         Alert[]
  tasks          Task[]
  entries        LeadEntry[]

  @@index([status])
  @@index([origin, intakeAt])
  @@index([subStatus])
  @@index([intakeAt])
}

model LeadEvent {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       String
  fromStatus String?
  toStatus   String?
  actor      String   @default("system")
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

model WebhookLog {
  id         String   @id @default(cuid())
  source     String
  rawPayload Json
  processed  Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([source, createdAt])
}

model Template {
  name        String   @id
  displayName String?
  bodyText    String?
  variables   Int      @default(0)
  approved    Boolean  @default(true)
  raw         Json?
  syncedAt    DateTime @default(now())
}

model Message {
  id              String   @id @default(cuid())
  leadId          String
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  direction       String   @default("out")
  templateName    String?
  bodyText        String?
  texterMessageId String?
  status          String   @default("sent")
  error           String?
  createdAt       DateTime @default(now())

  @@index([leadId, createdAt])
}

model Rule {
  id            String   @id @default(cuid())
  triggerStatus String
  stepIndex     Int
  delayMinutes  Int
  action        String   // send_template | notify | set_status
  templateName  String?
  targetStatus  String?
  note          String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([triggerStatus, stepIndex])
  @@index([triggerStatus])
}

model ScheduledJob {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ruleId       String?
  stepIndex    Int      @default(0)
  action       String
  templateName String?
  targetStatus String?
  runAt        DateTime
  state        String   @default("pending") // pending | done | cancelled | failed
  attempts     Int      @default(0)
  lastError    String?
  note         String?
  createdAt    DateTime @default(now())

  @@unique([leadId, ruleId, stepIndex])
  @@index([state, runAt])
}

model Alert {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  dueAt       DateTime?
  needsReview Boolean   @default(false)
  sourceQuestion String?
  urgent      Boolean   @default(false)
  done        Boolean   @default(false)
  doneAt      DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([done, dueAt])
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  topic     String
  answer    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Settings {
  id                   String   @id @default("main")
  botEnabled           Boolean  @default(true)
  botOnlyOutsideHours  Boolean  @default(false)
  botPauseHours        Int      @default(12)
  replyCooldownMinutes Int      @default(10)
  liveChatMinutes      Int      @default(30)
  onlyAfterTemplate    Boolean  @default(false)

  // הבוט נכנס לפעולה רק כשאתה לא בעבודה
  offDutyUntil          DateTime?
  afterHoursGrace       Int      @default(60)
  requireTemplateFirst  Boolean  @default(true)

  // הטקסטים שהעוזר שולח - ניתנים לעריכה מהמסך
  replyInterested      String   @default("היי, אסיים שיחה כמה דק ואתקשר :)")
  replyAfterHours      String   @default("היי, אני כבר סיימתי לעבוד. {מתי} מתאים לך?\nואם כן באיזה שעה :)")
  lastRunAt            DateTime?
  revenueTarget        Float     @default(0)
  leadRowFields        Json?
  replyCallback        String   @default("מעולה, רשמתי. אחזור אליך בזמן שביקשת :)")

  updatedAt            DateTime @updatedAt
}

model Status {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748b")
  position  Int      @default(100)
  terminal  Boolean  @default(false)
  won       Boolean  @default(false)
  builtin   Boolean  @default(false)
  commission Float   @default(0)
  createdAt DateTime @default(now())

  @@index([position])
}

model SubStatus {
  id         String   @id @default(cuid())
  statusName String
  name       String
  position   Int      @default(0)
  commission Float    @default(0)
  createdAt  DateTime @default(now())

  @@unique([statusName, name])
  @@index([statusName, position])
}

model Offer {
  id        String   @id @default(cuid())
  title     String
  price     String?
  decoders  String?
  streaming String?
  sports    String?
  freeText  String?
  targets   Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sends     OfferSend[]

  @@index([active, createdAt])
}

model OfferSend {
  id           String   @id @default(cuid())
  offerId      String
  offer        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  templateName String
  total        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([offerId])
}

model ImportRun {
  id        String   @id @default(cuid())
  fileName  String?
  rows      Int      @default(0)
  matched   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  report    Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// קמפיין שבו הלידים נמכרים ולא נעבדים
model SalesCampaign {
  id           String   @id @default(cuid())
  name         String   @unique
  pricePerLead Float    @default(0)
  buyer        String?
  buyerId      String?
  buyerRef     LeadBuyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

/// מי שקונה ממך לידים
model LeadBuyer {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  createdAt DateTime @default(now())

  campaigns SalesCampaign[]
}

/// כל כניסה של ליד, בנפרד.
/// אותו אדם יכול להיכנס מכמה קמפיינים - וכל כניסה נספרת.
model LeadEntry {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign  String?
  source    String?
  isSale    Boolean  @default(false)
  price     Float    @default(0)
  at        DateTime @default(now())

  @@index([isSale, at])
  @@index([leadId])
  @@index([campaign])
}
